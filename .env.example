# Copy to .env.local for local overrides. NEVER commit real secrets.
# Only VITE_* variables are exposed to the browser bundle.

# Keyless MapLibre style URL (default: OpenFreeMap dark). Alternatives:
#   https://tiles.openfreemap.org/styles/positron
#   https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json  (fallback)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Reserved for a FUTURE server-side narration pipeline (Phase 3+).
# Must never be prefixed with VITE_ and must never be read by client code.
ELEVENLABS_API_KEY=
